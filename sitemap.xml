---
# sitemap.xml nguồn: thay bản jekyll-sitemap 1.4.0 (github-pages 232) tự sinh — gem bỏ qua khi nguồn đã có trang /sitemap.xml
# (robots.txt nguồn giữ nguyên; gem cũng không sinh). Thân tệp = lib/sitemap.xml của gem rút khoảng trắng bằng đúng MINIFY_REGEX
# của gem => đầu ra trùng từng byte với bản gem sinh, chỉ khác:
#   1) <lastmod> của bài có trong _data/post-modified.json (khóa article_id; sinh bởi scripts/seo/build-post-modified.py từ sao lưu
#      revise-published) = ngày sửa nội dung thật, cùng giá trị BlogPosting.dateModified ở _includes/seo.html;
#   2) tệp tĩnh lấy từ site.static_files, lọc đúng phần mở rộng gem chọn (.htm .html .xhtml .pdf).
# Kiểm sau build: scripts/seo/check-regressions.py H7c (lastmod == dateModified). Không thụt lề/thêm dòng trống vào thân tệp.
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{% if page.xsl %}<?xml-stylesheet type="text/xsl" href="{{ "/sitemap.xsl" | absolute_url }}"?>
{% endif %}<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign sm_revised = site.data.post-modified.posts %}{% assign collections = site.collections | where_exp:'collection','collection.output != false' %}{% for collection in collections %}{% assign docs = collection.docs | where_exp:'doc','doc.sitemap != false' %}{% for doc in docs %}<url>
<loc>{{ doc.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
{% assign sm_rev = sm_revised[doc.article_id] %}{% if sm_rev.modified %}<lastmod>{{ sm_rev.modified | date_to_xmlschema }}</lastmod>
{% elsif doc.last_modified_at or doc.date %}<lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
{% endif %}</url>
{% endfor %}{% endfor %}{% assign pages = site.html_pages | where_exp:'doc','doc.sitemap != false' | where_exp:'doc','doc.url != "/404.html"' %}{% for page in pages %}<url>
<loc>{{ page.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
{% if page.last_modified_at %}<lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
{% endif %}</url>
{% endfor %}{% assign sm_exts = ".htm,.html,.xhtml,.pdf" | split: "," %}{% assign static_files = site.static_files | where_exp:'page','page.sitemap != false' | where_exp:'page','page.name != "404.html"' %}{% for file in static_files %}{% if sm_exts contains file.extname %}<url>
<loc>{{ file.path | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
<lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod>
</url>
{% endif %}{% endfor %}</urlset>
