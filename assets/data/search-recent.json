---
layout: null
permalink: /assets/data/search-recent.json
sitemap: false
---
{% assign recent_posts = site.posts | slice: 0, 300 %}
[
{% for post in recent_posts %}
  {
    "title": {{ post.title | default: '' | strip_html | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "description": {{ post.description | default: post.excerpt | default: '' | strip_html | normalize_whitespace | truncatewords: 24 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
